# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.pnpm-store/
/.wrangler/
/outputs/
/output/
/work/
/tmp/
/.venv/
/.flux-artifacts/
# Score Lab imports the small deterministic pilot fixtures at build time. Keep
# them versioned so a clean clone contains the same audited demo answer keys.
/research/score_v2/artifacts/*/observed.csv
/research/score_v2/artifacts/*/truth.json
/research/score_v3/artifacts/simulator-audit-v3.json
# The V6 runtime artifact is versioned; the full 14,400-candidate training
# cohort is reproducible locally and intentionally excluded from the release.
/research/score_v6/artifacts/cohort-v6.json
/research/svi_score_v3/artifacts/svi-score-v3-design-pilot.json
/research/svi_score_v10_amss/cloud/*.tar.gz
/research/svi_score_v10_amss/abandoned/
__pycache__/
*.pyc
