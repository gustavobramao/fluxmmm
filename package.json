{
  "name": "fluxmmm",
  "version": "1.0.0",
  "description": "Evidence-gated, local-first marketing mix modeling from data validation to posterior budget decisions.",
  "private": true,
  "license": "MIT",
  "author": "Gustavo Bramao",
  "homepage": "https://fluxmmm-web.web.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavobramao/fluxmmm.git"
  },
  "bugs": {
    "url": "https://github.com/gustavobramao/fluxmmm/issues"
  },
  "keywords": [
    "marketing-mix-modeling",
    "mmm",
    "bayesian",
    "causal-inference",
    "media-optimization"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mcmc:setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements-mcmc.txt",
    "mcmc:serve": ".venv/bin/python scripts/mcmc_server.py --port 8789",
    "mcmc:test": "PYTENSOR_FLAGS=base_compiledir=.flux-artifacts/pytensor-test .venv/bin/python -m unittest tests/test_mcmc_server.py",
    "research:score-v2:pilot": "node --import tsx research/score_v2/run-pilot.ts",
    "research:score-v2:matrix": "node --import tsx research/score_v2/run-pilot.ts --all",
    "research:score-v3:audit": "node --import tsx research/score_v3/run-audit.ts",
    "test:score-v2": "node --import tsx --test tests/simulation-score-v2.test.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --import tsx --test tests/data-contract.test.ts tests/models.test.ts tests/numerical-regression-fixtures.test.ts tests/simulation-score-v2.test.ts tests/simulator-audit-v3.test.ts && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .venv --ignore-pattern .flux-artifacts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
