{
  "name": "fluxmmm",
  "version": "4.0.0",
  "description": "Local-first Bayesian marketing mix modeling with evidence-adaptive RegretSet-MMM decision-focused model selection.",
  "private": true,
  "license": "MIT",
  "author": "Gustavo Bramao",
  "homepage": "https://fluxmmm-web.web.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavobramao/fluxmmm.git"
  },
  "bugs": {
    "url": "https://github.com/gustavobramao/fluxmmm/issues"
  },
  "keywords": [
    "marketing-mix-modeling",
    "mmm",
    "bayesian",
    "causal-inference",
    "media-optimization"
  ],
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mcmc:setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements-mcmc.txt",
    "research:paper:setup": "python3 -m venv .venv-research && .venv-research/bin/pip install -r requirements-research.txt",
    "research:paper:build": ".venv-research/bin/python research/svi_score_v9/build_journal_paper.py",
    "mcmc:serve": ".venv/bin/python scripts/mcmc_server.py --port 8790",
    "mcmc:test": "PYTENSOR_FLAGS=base_compiledir=.flux-artifacts/pytensor-test .venv/bin/python -m unittest tests/test_mcmc_server.py",
    "svi:test": "PYTENSOR_FLAGS=base_compiledir=.flux-artifacts/pytensor-test-svi .venv/bin/python -m unittest tests/test_svi_batch.py",
    "research:score-v2:pilot": "node --import tsx research/score_v2/run-pilot.ts",
    "research:score-v2:matrix": "node --import tsx research/score_v2/run-pilot.ts --all",
    "research:score-v3:audit": "node --import tsx research/score_v3/run-audit.ts",
    "research:score-v4:learn": "node --import tsx research/score_v4/run-learned-score.ts",
    "research:score-v4:refit": "node --import tsx research/score_v4/run-learned-score.ts --reuse-cohort",
    "research:score-v6:pilot": "node --import tsx research/score_v6/run-pilot.ts",
    "research:score-v6:refit": "node --import tsx research/score_v6/run-pilot.ts --reuse-cohort",
    "research:svi-score-v9:prepare": "node --import tsx research/svi_score_v9/prepare-dataset.ts",
    "research:svi-score-v9:train": ".venv/bin/python research/svi_score_v9/train_selector.py",
    "research:svi-score-v9:mechanism-holdout": ".venv/bin/python research/svi_score_v9/run-mechanism-holdout.py",
    "research:svi-score-v9:verify": "node --import tsx research/svi_score_v9/verify-development.ts",
    "research:svi-score-v9:audit-verify": "node --import tsx research/svi_score_v9/verify-sealed-audit.ts",
    "research:svi-score-v10-amss:verify-v9-freeze": "node --import tsx research/svi_score_v10_amss/verify-v9-freeze.ts",
    "research:svi-score-v10-amss:verify-protocol": "node --import tsx research/svi_score_v10_amss/verify-protocol.ts",
    "research:svi-score-v10-amss:verify-results": "node --import tsx research/svi_score_v10_amss/verify-inference-results.ts",
    "research:svi-score-v10-amss:build-audit": "node --import tsx research/svi_score_v10_amss/build-external-audit.ts",
    "research:svi-score-v11-ea:verify": "node --import tsx research/svi_score_v11_evidence_adaptive/verify-development.ts",
    "test:score-v2": "node --import tsx --test tests/simulation-score-v2.test.ts",
    "test:svi-score-v9": "node --import tsx --test tests/svi-score-v9.test.ts && .venv/bin/python -m unittest tests/test_svi_score_v9.py",
    "test:svi-score-v10-amss": "node --import tsx --test tests/svi-score-v10-amss.test.ts",
    "test:svi-score-v11-ea": "node --import tsx --test tests/svi-score-v11-evidence-adaptive.test.ts",
    "test:svi-score-v11-ea-python": ".venv/bin/python -m unittest tests/test_svi_score_v11_evidence_adaptive.py",
    "test:svi-score-v11-amss": "node --import tsx --test tests/svi-score-v11-amss-confirmatory.test.ts tests/svi-score-v11-amss-secondary-baselines.test.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --import tsx --test tests/data-contract.test.ts tests/models.test.ts tests/numerical-regression-fixtures.test.ts tests/simulation-score-v2.test.ts tests/simulator-audit-v3.test.ts tests/learned-score-v4.test.ts tests/learned-score-v6.test.ts && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .venv --ignore-pattern .flux-artifacts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
